{
  "_comment": "Claude fragment: Bash-only block guard; no envelope-driven ask. Native permission rules remain authoritative. Auxiliary hooks run local checks, not models. Installer preserves unrelated hooks and pins Python.",
  "permissions": {
    "allow": ["Bash(git status)", "Bash(git diff --no-ext-diff --no-textconv)", "PowerShell(Get-Location)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*cofre*.json)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm -r:*)",
      "Bash(rm -fr:*)",
      "Bash(rmdir:*)",
      "Bash(git rm:*)",
      "Bash(del /s:*)",
      "PowerShell(Remove-Item:*)",
      "Bash(higgsfield:*)",
      "Bash(scrapling:*)",
      "Bash(agent-reach:*)",
      "Bash(firecrawl:*)",
      "Bash(pip install:*)",
      "Bash(pipx install:*)",
      "Bash(npm install -g:*)",
      "Bash(npx skills add:*)",
      "Bash(npx -y:*)",
      "Bash(uvx:*)",
      "Bash(uv add:*)",
      "Bash(uv tool install:*)",
      "Bash(docker pull:*)",
      "Bash(docker run:*)",
      "Bash(docker compose:*)",
      "Bash(git clone:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{OMNIHARNESS_HOME}}/harness/guard_bash.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {"matcher": "startup|resume|clear", "hooks": [{"type": "command", "command": "python \"{{OMNIHARNESS_HOME}}/harness/hooks/verify.py\"", "timeout": 45}]}
    ],
    "PostToolUse": [
      {"matcher": "Write|Edit|MultiEdit", "hooks": [{"type": "command", "command": "python \"{{OMNIHARNESS_HOME}}/harness/hooks/verify.py\"", "timeout": 45}]}
    ]
  }
}
